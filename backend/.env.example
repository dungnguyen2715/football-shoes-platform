NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bootyard
MONGOOSE_AUTO_INDEX=true
ORDER_RESERVATION_TTL_HOURS=48

# Development-only secrets. Replace both with independent random values (32+ characters).
JWT_ACCESS_SECRET=replace-this-development-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-development-refresh-secret-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
CART_COOKIE_NAME=bootyard_cart
REFRESH_COOKIE_NAME=bootyard_refresh
COOKIE_DOMAIN=

# Optional SMTP settings. Forgot-password links are logged locally when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bootyard <no-reply@example.com>

# Optional first-admin bootstrap; use npm run seed:admin after MongoDB is running.
ADMIN_EMAIL=
ADMIN_PASSWORD=
